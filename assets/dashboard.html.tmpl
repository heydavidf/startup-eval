<!doctype html>
<html lang="en">
<head>
<meta charset="utf-8">
<meta name="viewport" content="width=device-width,initial-scale=1">
<title>{{TITLE}}</title>
<style>
:root{--ink:#10141b;--muted:#667085;--paper:#f4f6f8;--card:#fff;--line:#dfe4ea;--red:#c63c45;--amber:#c47a16;--green:#168467;--blue:#315ee7;--violet:#6941c6;--shadow:0 18px 45px rgba(16,24,40,.09)}
*{box-sizing:border-box}body{margin:0;background:var(--paper);color:var(--ink);font-family:Inter,ui-sans-serif,system-ui,-apple-system,BlinkMacSystemFont,"Segoe UI",sans-serif;line-height:1.5}button{font:inherit}
.shell{max-width:1180px;margin:auto;padding:28px}.topbar{display:flex;align-items:center;justify-content:space-between;gap:20px;margin-bottom:24px}.brand{font-size:12px;font-weight:800;letter-spacing:.16em;text-transform:uppercase;color:var(--violet)}
.toggle{display:flex;background:#e6e9ee;border-radius:999px;padding:4px}.toggle button{border:0;background:transparent;color:var(--muted);padding:8px 14px;border-radius:999px;cursor:pointer;font-weight:700}.toggle button.on{background:var(--card);color:var(--ink);box-shadow:0 2px 10px rgba(16,24,40,.12)}
.hero{background:linear-gradient(135deg,#111827 0%,#312e81 65%,#155e75 100%);color:white;border-radius:24px;padding:38px;box-shadow:var(--shadow);position:relative;overflow:hidden}.hero:after{content:"";position:absolute;width:360px;height:360px;border-radius:50%;right:-150px;top:-170px;background:radial-gradient(circle,rgba(255,255,255,.28),transparent 68%)}
.eyebrow{font-size:12px;font-weight:800;letter-spacing:.14em;text-transform:uppercase;color:#b9c7ff}.hero h1{font-size:clamp(38px,6vw,72px);line-height:.98;margin:14px 0 20px;max-width:820px}.hero p{font-size:18px;max-width:860px;color:#e6e9ff;margin:0}.hero-grid{display:grid;grid-template-columns:1fr auto;gap:30px;align-items:end}.score{font-size:64px;line-height:1;font-weight:900;font-variant-numeric:tabular-nums}.score small{font-size:16px;color:#cbd5e1}.verdict{display:inline-block;margin-top:8px;padding:7px 12px;border:1px solid rgba(255,255,255,.28);border-radius:999px;font-weight:800}
.grid{display:grid;grid-template-columns:repeat(12,1fr);gap:18px;margin-top:18px}.card{grid-column:span 12;background:var(--card);border:1px solid var(--line);border-radius:18px;padding:24px;box-shadow:0 8px 22px rgba(16,24,40,.05)}.half{grid-column:span 6}.third{grid-column:span 4}.wide{grid-column:span 8}.card h2{font-size:20px;margin:0 0 16px}.card h3{font-size:15px;margin:0}.lede{font-size:18px;line-height:1.62;margin:0}.muted{color:var(--muted)}
.metric{display:flex;align-items:baseline;justify-content:space-between;gap:18px;padding:12px 0;border-bottom:1px solid var(--line)}.metric:last-child{border-bottom:0}.metric b{font-size:24px}.pill{display:inline-flex;align-items:center;padding:4px 9px;border-radius:999px;font-size:12px;font-weight:800;text-transform:uppercase}.confirmed{background:#dff6ee;color:#0a684f}.uncertain{background:#fff0d5;color:#8a5105}.refuted{background:#fde5e7;color:#9d2831}.unverified{background:#eceff3;color:#475467}
.score-row{display:grid;grid-template-columns:180px 52px 1fr;gap:16px;align-items:center;padding:13px 0;border-bottom:1px solid var(--line)}.score-row:last-child{border-bottom:0}.score-n{font-size:24px;font-weight:900;text-align:center}.track{height:8px;background:#edf0f4;border-radius:999px;overflow:hidden}.track i{display:block;height:100%;background:linear-gradient(90deg,var(--violet),var(--blue));border-radius:999px}.rationale{color:var(--muted);font-size:14px;margin-top:7px}
table{border-collapse:collapse;width:100%;font-size:14px}th,td{text-align:left;vertical-align:top;padding:11px;border-bottom:1px solid var(--line)}th{font-size:11px;text-transform:uppercase;letter-spacing:.08em;color:var(--muted)}a{color:var(--blue);text-decoration:none}a:hover{text-decoration:underline}
.risk{display:grid;grid-template-columns:32px 1fr;gap:12px;padding:12px 0;border-bottom:1px solid var(--line)}.risk:last-child{border-bottom:0}.rank{width:28px;height:28px;border-radius:50%;display:grid;place-items:center;background:#f0eafe;color:var(--violet);font-weight:900}.scenario{padding:14px 0;border-bottom:1px solid var(--line)}.scenario:last-child{border-bottom:0}.scenario b{display:block;margin-bottom:3px}
.advanced-only{display:none}body.advanced .advanced-only{display:block}body.advanced .advanced-inline{display:initial}.advanced-inline{display:none}.footer{padding:28px 4px;color:var(--muted);font-size:12px;text-align:center}
@media(max-width:800px){.shell{padding:16px}.topbar{align-items:flex-start}.hero{padding:26px}.hero-grid{grid-template-columns:1fr}.half,.third,.wide{grid-column:span 12}.score-row{grid-template-columns:1fr 46px}.score-row>div:last-child{grid-column:1/-1}table{display:block;overflow-x:auto}.grid{gap:12px}}
</style>
</head>
<body>
<main class="shell">
  <div class="topbar"><div class="brand">Startup evaluation / {{DATE}}</div><div class="toggle" aria-label="Dashboard detail"><button id="bSimple" class="on" aria-pressed="true" onclick="setView('simple',false)">Simple</button><button id="bAdv" aria-pressed="false" onclick="setView('advanced',true)">Advanced</button></div></div>
  {{HERO}}
  <section class="grid">
    {{SIMPLE_BLOCKS}}
    <div id="advancedStart" class="card advanced-only">{{CLAIMS}}</div>
    <div class="card advanced-only">{{EVIDENCE}}</div>
    <div class="card advanced-only">{{METHODOLOGY}}</div>
  </section>
  <div class="footer">Generated by the startup-eval skill. Press <b>A</b> to toggle Simple / Advanced.</div>
</main>
<script>
function setView(view,scroll){
  const advanced=view==='advanced';
  document.body.classList.toggle('advanced',advanced);
  document.getElementById('bSimple').classList.toggle('on',!advanced);
  document.getElementById('bAdv').classList.toggle('on',advanced);
  document.getElementById('bSimple').setAttribute('aria-pressed',String(!advanced));
  document.getElementById('bAdv').setAttribute('aria-pressed',String(advanced));
  if(advanced&&scroll){setTimeout(()=>document.getElementById('advancedStart').scrollIntoView({behavior:'smooth',block:'start'}),40)}
}
document.addEventListener('keydown',event=>{if(event.key.toLowerCase()==='a'&&!event.metaKey&&!event.ctrlKey&&!event.altKey){setView(!document.body.classList.contains('advanced')?'advanced':'simple',false)}});
</script>
</body>
</html>
